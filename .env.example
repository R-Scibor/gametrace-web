# Copied into the Vite build (public SPA). Not secrets — still keep out of
# source so invites can rotate without a code change.
# docker compose reads this file for build args.

# Public server with bot already present (discord.gg/…)
VITE_DISCORD_SERVER_INVITE_URL=https://discord.gg/your-invite

# OAuth2 bot add URL (Developer Portal → OAuth2 → URL Generator:
# scopes bot + applications.commands)
VITE_DISCORD_BOT_INVITE_URL=https://discord.com/oauth2/authorize?client_id=YOUR_CLIENT_ID&permissions=2048&integration_type=0&scope=bot+applications.commands
